{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FractalDesk",
  "version": "1.0.0",
  "identifier": "dev.fractalmandala.fractaldesk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FractalDesk",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "resources": [
      "resources/palettes.json",
      "resources/README.md",
      "resources/LICENSE",
      "resources/schemes-spec-0.11/**/*"
    ],
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
